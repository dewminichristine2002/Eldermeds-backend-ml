{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eldermeds.local/schemas/context-emotion-1.0.json",
  "title": "ElderMeds Human Annotated Context Emotion Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "participant_group_id", "session_id", "turn_index", "current_question", "current_answer", "previous_turns", "emotion_label", "annotation_source", "annotation_status"],
  "properties": {
    "schema_version": {"const": "eldermeds-context-emotion-1.0"},
    "sample_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "participant_group_id": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Pseudonymous identifier assigned only to genuine consented data; never fabricate."},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "turn_index": {"type": "integer", "minimum": 1},
    "current_question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "current_answer": {"type": "string", "minLength": 1, "maxLength": 2000},
    "previous_turns": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/turn"}},
    "emotion_label": {"enum": ["happiness", "sadness", "loneliness", "anxiety", "anger", "cognitive_fog", "neutral"]},
    "annotation_source": {"enum": ["human_single_review", "human_double_review", "human_adjudication"]},
    "annotation_status": {"enum": ["reviewed", "adjudicated"]}
  },
  "$defs": {
    "turn": {
      "type": "object", "additionalProperties": false,
      "required": ["participant_group_id", "session_id", "turn_index", "question", "answer"],
      "properties": {
        "participant_group_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "turn_index": {"type": "integer", "minimum": 1},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "answer": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
