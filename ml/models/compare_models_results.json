{
  "section": "11.1_algorithm_comparison",
  "viva_rationale": "Random Forest as an ensemble tree method, XGBoost as a gradient boosting variant, and Logistic Regression as an interpretable linear baseline \u2014 together they represent a spectrum from simple to complex, allowing meaningful comparison.",
  "algorithms": [
    "random_forest",
    "xgboost",
    "logistic_regression"
  ],
  "datasets": [
    "FAERS"
  ],
  "rows": 11868,
  "target": "adr_event",
  "binary_classes": [
    "no_adr",
    "severe_adr"
  ],
  "hybrid_evaluation": {
    "formula": "hybridScore = round(0.6 * ruleScore + 0.4 * mlDangerScore)",
    "alpha": 0.6,
    "beta": 0.4,
    "ground_truth_column": "risk_label_eval",
    "note": "3-class labels are evaluation-only; all models train on binary adr_event."
  },
  "feature_columns": [
    "patient_age",
    "num_current_meds",
    "ddi_pair_count",
    "sider_adr_count",
    "has_renal_disease",
    "has_hepatic_disease",
    "has_diabetes",
    "has_cardiovascular",
    "has_epilepsy",
    "allergy_class_overlap",
    "drug_hepatic_metabolism",
    "drug_renal_excretion",
    "nti_drug_flag",
    "allergy_severity_max",
    "ddi_severity_max",
    "patient_sex",
    "atc_class_encoded"
  ],
  "validation_protocol": {
    "train_test_split": "80/20 stratified on adr_event",
    "cross_validation": "5-fold StratifiedKFold on training set only",
    "balancing": "SMOTE inside pipeline for all three models equally",
    "holdout_metrics": "Accuracy, Precision, Recall, F1 (weighted + macro), AUC-ROC"
  },
  "implementations": [
    {
      "model": "random_forest",
      "implementation": "sklearn RandomForestClassifier \u2014 primary proposed baseline"
